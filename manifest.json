{
  "manifest_version": 3,
  "name": "stackytab",
  "version": "0.1.0.1",
  "description": "A new tab page of editable pane stacks — Markdown notes and Excalidraw canvases.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4b53e80a-c5f8-452a-a9c2-7e292e13020a}",
      "strict_min_version": "113.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
